{
  "name": "pdfcombo",
  "productName": "PDF Combo",
  "version": "0.1.0",
  "description": "Select, preview, reorder and combine PDF files into one document.",
  "main": "src/main/main.js",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Wessel Meijer",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "start": "npm run vendor && electron .",
    "dist": "npm run vendor && electron-builder",
    "dist:win": "npm run vendor && electron-builder --win",
    "dist:mac": "npm run vendor && node scripts/dist-mac.js",
    "dist:linux": "npm run vendor && electron-builder --linux",
    "postinstall": "node scripts/vendor.js",
    "testdata": "node scripts/make-test-pdfs.js",
    "smoke": "npm run vendor && npm run testdata && node scripts/run-smoke.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "lucide-static": "^1.38.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "build": {
    "appId": "com.pdfcombo.app",
    "productName": "PDF Combo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "role": "Viewer"
      }
    ],
    "icon": "build/icon.png"
  }
}
